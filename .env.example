KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=restrackit
KEYCLOAK_CONNECTOR_CLIENT_ID=pantry-mcp-connector
KEYCLOAK_EXCHANGE_CLIENT_ID=pantry-mcp-token-exchange
# Either set the secret directly, or point at its Secrets Manager entry name
# (the Lambda deploy uses the latter — see infra/stacks/pantry_mcp_stack.py).
# Must match the secret configured on Keycloak's pantry-mcp-token-exchange
# client (provisioned from restrackit-core) — the two are not auto-synced.
KEYCLOAK_EXCHANGE_CLIENT_SECRET=changeme
# KEYCLOAK_EXCHANGE_CLIENT_SECRET_NAME=pantry-mcp/token-exchange-client
RESTRACKIT_BACKEND_CLIENT_ID=restrackit-backend
RESTRACKIT_BASE_URL=https://api.restrackit.example.com/v1
# Public URL this server is reached at, no trailing slash and no path (e.g.
# the API Gateway ApiUrl from the CDK output). Used to build the RFC 9728
# oauth-protected-resource document and the 401 WWW-Authenticate header.
MCP_PUBLIC_BASE_URL=https://changeme.execute-api.eu-west-1.amazonaws.com
# Only needed to run tests/test_integration.py locally (RUN_INTEGRATION_TESTS=1):
# a real restrackit-core store_id and a tenant user account for it. That
# account must have Direct Access Grants temporarily enabled on
# pantry-mcp-connector in Keycloak, purely so the test can obtain a real user
# token without driving a browser through the OAuth login flow (production
# never does this — see the test module's docstring).
RESTRACKIT_TEST_STORE_ID=1
RESTRACKIT_TEST_KEYCLOAK_USERNAME=changeme
RESTRACKIT_TEST_KEYCLOAK_PASSWORD=changeme
